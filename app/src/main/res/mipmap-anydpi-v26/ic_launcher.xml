@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun HomeScreen(
    viewModel: SmartNotesViewModel,
    onNavigateToScan: () -> Unit,
    onNavigateToSubjects: () -> Unit,
    onNavigateToStudy: () -> Unit,
    onOpenNote: (Long) -> Unit
) {
    val uiState by viewModel.uiState.collectAsState()
    val notes = uiState.notes

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Smart Notes") },
                actions = {
                    IconButton(onClick = onNavigateToStudy) {
                        Icon(Icons.Default.Star, contentDescription = "Study")
                    }
                }
            )
        }
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(16.dp)
        ) {
            SearchBar(viewModel)

            val quickActions = listOf(
                "Create Note" to onNavigateToScan,
                "Scan Notes" to onNavigateToScan,
                "My Notes" to { },
                "Subjects" to onNavigateToSubjects,
                "Study Mode" to onNavigateToStudy
            )

            quickActions.chunked(2).forEach { rowItems ->
                Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                    rowItems.forEach { (label, action) ->
                        Button(
                            onClick = action,
                            modifier = Modifier.weight(1f)
                        ) {
                            Text(label)
                        }
                    }
                }
            }

            if (uiState.errorMessage != null) {
                Card(colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.errorContainer)) {
                    Text(
                        text = uiState.errorMessage,
                        modifier = Modifier.padding(16.dp),
                        color = MaterialTheme.colorScheme.onErrorContainer
                    )
                }
            }

            if (uiState.infoMessage != null) {
                Card(colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.primaryContainer)) {
                    Text(
                        text = uiState.infoMessage,
                        modifier = Modifier.padding(16.dp),
                        color = MaterialTheme.colorScheme.onPrimaryContainer
                    )
                }
            }

            Text(
                text = "Recently viewed",
                style = MaterialTheme.typography.titleMedium,
                fontWeight = FontWeight.Bold
            )

            if (notes.isEmpty()) {
                Card {
                    Text(
                        text = "No notes yet. Scan or create a note to get started.",
                        modifier = Modifier.padding(20.dp)
                    )
                }
            } else {
                LazyColumn(
                    verticalArrangement = Arrangement.spacedBy(10.dp),
                    modifier = Modifier.fillMaxWidth()
                ) {
                    items(notes.take(8)) { note ->
                        NoteCard(note = note, onClick = { onOpenNote(note.id) })
                    }
                }
            }
        }
    }
}

@Composable
private fun SearchBar(viewModel: SmartNotesViewModel) {
    var query by remember { mutableStateOf("") }

    OutlinedTextField(
        value = query,
        onValueChange = {
            query = it
            viewModel.updateSearch(it)
        },
        modifier = Modifier.fillMaxWidth(),
        leadingIcon = { Icon(Icons.Default.Search, contentDescription = null) },
        placeholder = { Text("Search notes, subjects, or tags") },
        singleLine = true,
        keyboardOptions = KeyboardOptions(capitalization = KeyboardCapitalization.Sentences)
    )
}

@Composable
fun NoteCard(note: NoteEntity, onClick: () -> Unit) {
    Card(
        modifier = Modifier
            .fillMaxWidth()
            .clickable { onClick() },
        elevation = CardDefaults.cardElevation(defaultElevation = 2.dp),
        shape = RoundedCornerShape(16.dp)
    ) {
        Column(
            modifier = Modifier.padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(8.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(note.title, style = MaterialTheme.typography.titleMedium, fontWeight = FontWeight.Bold)
                Text(note.subjectName ?: "General", color = MaterialTheme.colorScheme.primary)
            }
            Text(
                text = note.content.take(120).ifBlank { "No content" },
                maxLines = 3,
                style = MaterialTheme.typography.bodyMedium
            )
            if (note.tags.isNotBlank()) {
                Text(text = "Tags: ${note.tags}", color = MaterialTheme.colorScheme.outline)
            }
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun ScanNotesScreen(
    viewModel: SmartNotesViewModel,
    onBack: () -> Unit,
    onSaved: () -> Unit
) {
    val context = LocalContext.current
    val uiState by viewModel.uiState.collectAsState()
    var title by remember { mutableStateOf("") }
    var tags by remember { mutableStateOf("") }
    var extractedText by remember { mutableStateOf("") }
    var selectedSubjectId by remember { mutableStateOf<Long?>(null) }
    var isBusy by remember { mutableStateOf(false) }
    var errorText by remember { mutableStateOf<String?>(null) }

    val cameraPermissionLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.RequestPermission()
    ) { granted ->
        if (granted) {
            // In a production build, a photo capture launcher would be used here.
            errorText = "Camera access granted. The demo flow uses a simple OCR import path."
        } else {
            errorText = "Camera permission is required to capture notes."
        }
    }

    val pickImageLauncher = rememberLauncherForActivityResult(
        ActivityResultContracts.PickVisualMedia()
    ) { uri ->
        if (uri != null) {
            isBusy = true
            errorText = null
            androidx.lifecycle.viewmodel.compose.viewModel
            androidx.lifecycle.viewmodel.compose.viewModel
            viewModel.viewModelScope.launch {
                val result = viewModel.extractTextFromImage(uri)
                result.onSuccess {
                    extractedText = it
                }.onFailure {
                    errorText = it.message ?: "OCR failed. Please try another image."
                }
                isBusy = false
            }
        }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Scan Notes") },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
                    }
                }
            )
        }
    ) { padding ->
        LazyColumn(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            item {
                Row(horizontalArrangement = Arrangement.spacedBy(12.dp)) {
                    Button(
                        onClick = {
                            cameraPermissionLauncher.launch(Manifest.permission.CAMERA)
                            errorText = "Please choose an image from the gallery for OCR in this MVP flow."
                        },
                        modifier = Modifier.weight(1f)
                    ) {
                        Icon(Icons.Default.CameraAlt, contentDescription = null)
                        Spacer(Modifier.size(8.dp))
                        Text("Camera")
                    }
                    Button(
                        onClick = { pickImageLauncher.launch(PickVisualMediaRequest(ActivityResultContracts.PickVisualMedia.ImageOnly)) },
                        modifier = Modifier.weight(1f)
                    ) {
                        Icon(Icons.Default.Image, contentDescription = null)
                        Spacer(Modifier.size(8.dp))
                        Text("Gallery")
                    }
                }
            }

            item {
                if (errorText != null) {
                    Card(colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.errorContainer)) {
                        Text(
                            text = errorText ?: "",
                            modifier = Modifier.padding(16.dp),
                            color = MaterialTheme.colorScheme.onErrorContainer
                        )
                    }
                }
            }

            item {
                OutlinedTextField(
                    value = title,
                    onValueChange = { title = it },
                    modifier = Modifier.fillMaxWidth(),
                    label = { Text("Note title") }
                )
            }

            item {
                OutlinedTextField(
                    value = tags,
                    onValueChange = { tags = it },
                    modifier = Modifier.fillMaxWidth(),
                    label = { Text("Tags (comma separated)") }
                )
            }

            item {
                OutlinedTextField(
                    value = extractedText,
                    onValueChange = { extractedText = it },
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(260.dp),
                    label = { Text("OCR text") }
                )
            }

            item {
                if (isBusy) {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        CircularProgressIndicator(modifier = Modifier.size(18.dp))
                        Spacer(Modifier.size(8.dp))
                        Text("Detecting text...")
                    }
                }
            }

            item {
                Button(
                    onClick = {
                        if (extractedText.isBlank()) {
                            errorText = "Please scan or enter some text before saving."
                            return@Button
                        }
                        viewModel.saveNote(
                            title = title,
                            content = extractedText,
                            subjectId = selectedSubjectId,
                            tags = tags
                        )
                        onSaved()
                    },
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Icon(Icons.Default.NoteAdd, contentDescription = null)
                    Spacer(Modifier.size(8.dp))
                    Text("Save note")
                }
            }
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun SubjectsScreen(
    viewModel: SmartNotesViewModel,
    onBack: () -> Unit
) {
    val uiState by viewModel.uiState.collectAsState()
    var newSubject by remember { mutableStateOf("") }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Subjects") },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
                    }
                }
            )
        }
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(padding)
                .padding(16.dp),
            verticalArrangement = Arrangement.spacedBy(12.dp)
        ) {
            OutlinedTextField(
                value = newSubject,
                onValueChange = { newSubject = it },
                modifier = Modifier.fillMaxWidth(),
                label = { Text("Create subject") }
            )
            Button(
                onClick = {
                    viewModel.saveSubject(newSubject)
                    newSubject = ""
                },
                modifier = Modifier.fillMaxWidth()
            ) {
                Icon(Icons.Default.Subject, contentDescription = null)
                Spacer(Modifier.size(8.dp))
                Text("Add subject")
            }

            if (uiState.subjects.isEmpty()) {
                Text("No subjects yet. Add your first subject.")
            } else {
                uiState.subjects.forEach { subject ->
                    Card(
                        modifier = Modifier.fillMaxWidth(),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .padding(16.dp),
                            horizontalArrangement = Arrangement.SpaceBetween,
                            verticalAlignment = Alignment.CenterVertically
                        ) {
                            Text(subject.name, fontWeight = FontWeight.Bold)
                            Icon(Icons.Default.Delete, contentDescription = null)
                        }
                    }
                }
            }
        }
    }
}

